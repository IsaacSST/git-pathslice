#!/usr/bin/env python3
"""git pathslice: path-scoped branches derived from another branch.

A slice names a set of paths (for example docs/) and a base branch (for
example main).  `git pathslice update <name>` rebuilds the branch
pathslice/<name>/<from> as <base> plus the commits on <from> that touch the
slice's paths, each restricted to those paths, skipping whatever <base>
already contains.  The result can be pull-requested into <base> on its own.

Export records are kept under refs/pathslices/, scoped to the slice's paths
and destination. Each record identifies the commits exported and those known
to have landed. Interrupted updates retain their temporary worktree.

"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass, field
from typing import Dict, List, Optional, Set, Tuple

VERSION = "0.2.0"
SHARED_FILE = ".gitpathslices"
REF_ROOT = "refs/pathslices"
BRANCH_ROOT = "pathslice"
TRAILER = "Sliced-From"
MARK_TRAILER = "Slice"
SCOPE_TRAILER = "Pathslice"
SELECTS = ("all", "pure", "marked")
MIN_GIT = (2, 22)


class SliceError(Exception):
    pass


def _b(s):
    return s if isinstance(s, (bytes, type(None))) else s.encode("utf-8", "surrogateescape")


def _s(b):
    return b.decode("utf-8", "replace")


def _clean_env():
    env = dict(os.environ)
    for k in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR", "GIT_OBJECT_DIRECTORY"):
        env.pop(k, None)
    return env


def short(sha):
    return sha[:10]


# --------------------------------------------------------------------- repo


class Repo:
    def __init__(self):
        rc, out, err = self._exec(["rev-parse", "--show-toplevel"], os.getcwd())
        if rc != 0:
            raise SliceError("not inside a git work tree")
        self.top = _s(out).strip()
        self.common = os.path.abspath(os.path.join(self.top, self.run("rev-parse", "--git-common-dir").strip()))
        wt_root = os.path.join(self.common, "pathslice", "wt")
        if os.path.realpath(self.top).startswith(os.path.realpath(wt_root) + os.sep):
            # invoked from inside one of our temporary worktrees: use the main one
            first = self.run("worktree", "list", "--porcelain").splitlines()[0]
            self.top = first[len("worktree "):]
        self._features = None

    @staticmethod
    def _exec(args, cwd, input=None, env=None):
        p = subprocess.run(["git", *args], cwd=cwd, input=_b(input),
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
        return p.returncode, p.stdout, p.stderr

    def try_run(self, *args, input=None, cwd=None, binary=False, env_extra=None) -> Tuple[int, object, str]:
        env = _clean_env() if (cwd or env_extra) else None
        if env_extra:
            env.update(env_extra)
        rc, out, err = self._exec(list(args), cwd or self.top, input, env)
        return rc, (out if binary else _s(out)), _s(err)

    def run(self, *args, input=None, cwd=None, binary=False, env_extra=None):
        rc, out, err = self.try_run(*args, input=input, cwd=cwd, binary=binary, env_extra=env_extra)
        if rc != 0:
            raise SliceError("git %s failed:\n%s" % (" ".join(args[:2]), err.strip()))
        return out

    # refs -------------------------------------------------------------
    def rev(self, rev) -> Optional[str]:
        rc, out, _ = self.try_run("rev-parse", "--verify", "--quiet", rev + "^{commit}")
        return out.strip() if rc == 0 else None

    def is_ancestor(self, a, b) -> bool:
        rc, _, err = self.try_run("merge-base", "--is-ancestor", a, b)
        if rc not in (0, 1):
            raise SliceError(err.strip())
        return rc == 0

    def update_ref(self, ref, sha):
        self.run("update-ref", ref, sha)

    def delete_ref(self, ref):
        self.try_run("update-ref", "-d", ref)

    def current_branch(self) -> Optional[str]:
        rc, out, _ = self.try_run("symbolic-ref", "--short", "-q", "HEAD")
        return out.strip() if rc == 0 else None

    def branch_checked_out_at(self, branch) -> Optional[str]:
        path = None
        for line in self.run("worktree", "list", "--porcelain").splitlines():
            if line.startswith("worktree "):
                path = line[len("worktree "):]
            elif line == "branch refs/heads/" + branch:
                return path
        return None

    def worktree_registered(self, path) -> bool:
        real = os.path.realpath(path)
        for line in self.run("worktree", "list", "--porcelain").splitlines():
            if line.startswith("worktree ") and os.path.realpath(line[len("worktree "):]) == real:
                return True
        return False

    def check_ref_format(self, branch):
        rc, _, _ = self.try_run("check-ref-format", "--branch", branch)
        if rc != 0:
            raise SliceError("'%s' is not a valid branch name" % branch)

    # features ---------------------------------------------------------
    def features(self) -> Dict[str, bool]:
        if self._features is None:
            m = re.search(r"(\d+)\.(\d+)", self.run("--version"))
            ver = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
            if ver < MIN_GIT:
                raise SliceError("git pathslice needs git %d.%d or newer" % MIN_GIT)
            _, out, err = self.try_run("am", "-h")
            _, mt_out, mt_err = self.try_run("merge-tree", "-h")
            self._features = {"am_no_verify": "--no-verify" in out + err,
                              "merge_tree_write": "--write-tree" in mt_out + mt_err}
        return self._features


# ------------------------------------------------------------------- config

@dataclass
class Slice:
    name: str
    paths: List[str] = field(default_factory=list)
    base: Optional[str] = None
    select: str = "all"
    subject: Optional[str] = None
    where: List[str] = field(default_factory=list)


def _config_entries(repo, file=None) -> List[Tuple[str, str]]:
    args = ["config", "-z"]
    if file:
        if not os.path.exists(os.path.join(repo.top, file)):
            return []
        args += ["--file", file]
    args += ["--get-regexp", r"^pathslice\."]
    rc, out, err = repo.try_run(*args)
    if rc == 1:
        return []
    if rc != 0:
        raise SliceError(err.strip())
    entries = []
    for item in out.split("\0"):
        if not item:
            continue
        key, _, value = item.partition("\n")
        entries.append((key, value))
    return entries


def load_slices(repo) -> Dict[str, Slice]:
    slices: Dict[str, Slice] = {}
    for where, file in (("shared", SHARED_FILE), ("local", None)):
        for key, value in _config_entries(repo, file):
            body = key[len("pathslice."):]
            name, _, field_ = body.rpartition(".")
            if not name or not field_:
                continue
            sl = slices.setdefault(name, Slice(name=name))
            if where not in sl.where:
                sl.where.append(where)
            if field_ == "path":
                if value not in sl.paths:
                    sl.paths.append(value)
            elif field_ == "base":
                sl.base = value
            elif field_ == "select":
                if value not in SELECTS:
                    raise SliceError("pathslice.%s.select must be one of %s" % (name, ", ".join(SELECTS)))
                sl.select = value
            elif field_ == "subject":
                sl.subject = value
    return slices


def default_base(repo) -> str:
    rc, out, _ = repo.try_run("symbolic-ref", "-q", "refs/remotes/origin/HEAD")
    if rc == 0:
        return out.strip().replace("refs/remotes/", "", 1)
    for cand in ("main", "master"):
        if repo.rev(cand):
            return cand
    raise SliceError("cannot guess a base branch; set one with --base")


def get_slice(repo, name) -> Slice:
    slices = load_slices(repo)
    if name not in slices:
        raise SliceError("no slice named '%s' (see `git pathslice list`)" % name)
    sl = slices[name]
    if not sl.paths:
        raise SliceError("slice '%s' has no paths" % name)
    if not sl.base:
        sl.base = default_base(repo)
    return sl


def normalise_path(p: str) -> str:
    prefix = os.environ.get("GIT_PREFIX", "")
    if prefix and not p.startswith(":"):
        p = os.path.normpath(os.path.join(prefix, p))
    return p


def state_root(name, frm):
    return "%s/%s/%s" % (REF_ROOT, name, frm)


def projection_scope(sl, base):
    definition = json.dumps([sl.name, sl.paths, base], ensure_ascii=True)
    return hashlib.sha256(definition.encode()).hexdigest()


def read_record(repo, ref):
    sha = repo.rev(ref)
    return sha, json.loads(repo.run("log", "-1", "--format=%B", sha)) if sha else {}


def record_commit(repo, record, previous):
    # Parents retain the exported history even after source branches are rewritten.
    tree = repo.run("mktree", input="").strip()
    parents = dict.fromkeys(p for p in (previous, record["source"], record.get("head"),
                                      record["base"], record.get("checked_base")) if p)
    args = [arg for parent in parents for arg in ("-p", parent)]
    env = _committer_env(repo, record["source"])
    env.update({key.replace("COMMITTER", "AUTHOR"): value for key, value in list(env.items())})
    return repo.run("commit-tree", tree, *args, input=json.dumps(record, sort_keys=True),
                    env_extra=env).strip()


def branch_name(name, frm) -> str:
    return "%s/%s/%s" % (BRANCH_ROOT, name, frm)


def escape(s: str) -> str:
    return s.replace("%", "%25").replace("/", "%2F")


def worktree_path(repo, name, frm) -> str:
    return os.path.join(repo.common, "pathslice", "wt", escape(name), escape(frm))


def state_path(repo, name, frm) -> str:
    return os.path.join(repo.common, "pathslice", "state", escape(name), escape(frm) + ".json")


# ----------------------------------------------------------------- analysis

@dataclass
class Candidate:
    sha: str
    subject: str
    pure: bool
    marked: bool
    decision: str = "replay"


@dataclass
class Analysis:
    sl: Slice
    frm: str
    frm_sha: str
    base: str
    base_sha: str
    branch: str
    branch_sha: Optional[str]
    scope: str
    record_ref: str
    record_sha: Optional[str]
    record: dict
    landed: Set[str]
    checkpoints: List[str]
    landed_how: Optional[str]
    warnings: List[str]
    candidates: List[Candidate]

    def to_replay(self) -> List[Candidate]:
        return [c for c in self.candidates if c.decision == "replay"]


def _describe(repo, shas: List[str], sl: Slice) -> List[Candidate]:
    if not shas:
        return []
    stdin = "\n".join(shas) + "\n"
    fmt = "%H%x1f%s%x1f%(trailers:key=" + MARK_TRAILER + ",valueonly,separator=%x2c)"
    meta = {}
    for line in repo.run("log", "--no-walk=unsorted", "--stdin", "--format=" + fmt, input=stdin).splitlines():
        parts = line.split("\x1f")
        if len(parts) >= 2:
            meta[parts[0]] = (parts[1], parts[2] if len(parts) > 2 else "")

    def files(pathspec):
        out = repo.run("log", "--no-walk=unsorted", "--stdin", "--format=%x00%H", "--name-only",
                       *pathspec, input=stdin)
        res = {}
        for chunk in out.split("\0"):
            lines = [line for line in chunk.splitlines() if line.strip()]
            if lines:
                res[lines[0]] = set(lines[1:])
        return res

    all_files = files([])
    in_files = files(["--", *sl.paths])
    rx = re.compile(sl.subject) if sl.subject else None
    cands = []
    for sha in shas:
        subject, marks = meta.get(sha, ("", ""))
        pure = all_files.get(sha, set()) == in_files.get(sha, set())
        marked = any(m.strip().lower() == sl.name.lower() for m in marks.split(",") if m.strip())
        if rx and rx.search(subject):
            marked = True
        cands.append(Candidate(sha, subject, pure, marked))
    return cands


def _provenance(repo, scope, *revs):
    fmt = "%(trailers:key=" + SCOPE_TRAILER + ",valueonly,separator=%x2c)"
    out = repo.run("log", "--reverse", "--format=" + fmt, *revs)
    sources = []
    for line in out.splitlines():
        for value in line.split(","):
            parts = value.split()
            if len(parts) == 2 and parts[0] == scope:
                sources.append(parts[1])
    return sources


def _content_landed(repo, branch_sha, base_sha, previous_base, paths) -> bool:
    shas = repo.run("rev-list", base_sha, "^" + previous_base, "--", *paths).split()
    for s in shas:
        rc, _, _ = repo.try_run("diff", "--quiet", s, branch_sha, "--", *paths)
        if rc == 0:
            return True
    return False


def analyse(repo, sl: Slice, frm: str, base: Optional[str] = None, all_: bool = False,
            branch: Optional[str] = None) -> Analysis:
    base = base or sl.base
    base_sha, frm_sha = repo.rev(base), repo.rev(frm)
    if not base_sha or not frm_sha:
        raise SliceError("source and base must both name commits")
    if frm_sha == base_sha:
        raise SliceError("'%s' and base '%s' are the same commit" % (frm, base))
    branch = branch or branch_name(sl.name, frm)
    repo.check_ref_format(branch)
    branch_sha = repo.rev("refs/heads/" + branch)
    scope = projection_scope(sl, base)
    record_ref = state_root(sl.name, frm) + "/exports/" + scope
    record_sha, record = read_record(repo, record_ref)
    warnings = []
    landed = set()
    checkpoints = record.get("checkpoints", [])
    if any(not repo.is_ancestor(cp, frm_sha) for cp in checkpoints):
        warnings.append("%s was rewritten; unreachable manual checkpoints are ignored" % frm)
        checkpoints = [cp for cp in checkpoints if repo.is_ancestor(cp, frm_sha)]

    landed_how = None
    if record and repo.is_ancestor(record["base"], base_sha):
        if repo.is_ancestor(record.get("checked_base", record["base"]), base_sha):
            landed.update(record.get("landed", []))
        head = record.get("head")
        if head and repo.is_ancestor(head, base_sha):
            landed_how = "merged"
        elif head and _content_landed(repo, head, base_sha, record["base"], sl.paths):
            landed_how = "content"
        if landed_how:
            landed.update(record["replayed"])

    landed.update(_provenance(repo, scope, base_sha, "^" + frm_sha))
    revs = ["rev-list", "--reverse", "--topo-order", "--no-merges", "--right-only", "--cherry-mark",
            base_sha + "..." + frm_sha]
    revs.extend("^" + cp for cp in checkpoints)
    marked = repo.run(*revs, "--", *sl.paths).split()
    equivalents = {line[1:] for line in marked if line.startswith("=")}
    cands = _describe(repo, [line[1:] for line in marked], sl)
    for c in cands:
        if c.sha in landed:
            c.decision = "landed (trailer)"
        elif c.sha in equivalents:
            c.decision = "landed (patch-id)"
        elif not all_ and sl.select == "pure" and not c.pure:
            c.decision = "skip (mixed)"
        elif not all_ and sl.select == "marked" and not c.marked:
            c.decision = "skip (unmarked)"
    landed.update(equivalents)
    return Analysis(sl, frm, frm_sha, base, base_sha, branch, branch_sha, scope,
                    record_ref, record_sha, record, landed, checkpoints, landed_how, warnings, cands)

# -------------------------------------------------------------------- build


def _save_state(repo, st, create=False):
    path = state_path(repo, st["name"], st["frm"])
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".%d.tmp" % os.getpid()
    with open(tmp, "w") as f:
        json.dump(st, f, indent=1)
    try:
        if create:
            os.link(tmp, path)
        else:
            os.replace(tmp, path)
    except FileExistsError:
        raise SliceError("an update is already in progress; run continue or abort")
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def _load_state(repo, name, frm) -> Optional[dict]:
    path = state_path(repo, name, frm)
    if not os.path.exists(path):
        return None
    with open(path) as f:
        return json.load(f)


def _drop_state(repo, name, frm):
    path = state_path(repo, name, frm)
    if os.path.exists(path):
        os.remove(path)


def _remove_worktree(repo, wt):
    if repo.worktree_registered(wt):
        repo.try_run("worktree", "remove", "--force", wt)
    if os.path.isdir(wt):
        shutil.rmtree(wt, ignore_errors=True)
    repo.try_run("worktree", "prune")


def _prepare_worktree(repo, wt, base_sha):
    _remove_worktree(repo, wt)
    os.makedirs(os.path.dirname(wt), exist_ok=True)
    repo.run("worktree", "add", "--detach", wt, base_sha)


def _wt_head(repo, wt) -> str:
    return repo.run("rev-parse", "HEAD", cwd=wt).strip()


def _am_in_progress(repo, wt) -> bool:
    p = repo.run("rev-parse", "--git-path", "rebase-apply", cwd=wt).strip()
    return os.path.isdir(os.path.join(wt, p) if not os.path.isabs(p) else p)


def _make_patch(repo, sha, paths, scope) -> bytes:
    patch = repo.run("-c", "format.signoff=false", "-c", "diff.noprefix=false",
                    "-c", "diff.mnemonicprefix=false", "-c", "format.useautobase=false",
                    "format-patch", "-1", "-k", "--stdout", "--binary", "--full-index",
                    "--no-signature", "--no-thread", "--no-cover-letter", "--no-notes",
                    "--no-numbered", sha, "--", *paths, binary=True)
    return repo.run("interpret-trailers", "--if-exists", "addIfDifferent",
                    "--trailer", "%s: %s" % (TRAILER, sha),
                    "--trailer", "%s: %s %s" % (SCOPE_TRAILER, scope, sha),
                    input=patch, binary=True)


def _committer_env(repo, src_sha) -> Dict[str, str]:
    """Use the source committer identity and date for deterministic replay."""
    name, email, date = repo.run("log", "-1", "--format=%cn%x1f%ce%x1f%cI", src_sha).strip().split("\x1f")
    return {"GIT_COMMITTER_NAME": name, "GIT_COMMITTER_EMAIL": email, "GIT_COMMITTER_DATE": date}


def _run_queue(repo, st, quiet=False):
    wt = st["worktree"]
    am = ["am", "-3", "-k"]
    if repo.features()["am_no_verify"]:
        am.append("--no-verify")
    while st["queue"]:
        source = st["queue"][0]
        # A successful am may precede an interrupted journal write.
        if source not in _provenance(repo, st["scope"], "-1", _wt_head(repo, wt)):
            patch = _make_patch(repo, source, st["paths"], st["scope"])
            rc, _, err = repo.try_run(*am, cwd=wt, input=patch,
                                     env_extra=_committer_env(repo, source))
            if rc != 0:
                subject = repo.run("log", "-1", "--format=%s", source).strip()
                sys.stderr.write(
                    "conflict while replaying %s %s\n%s\n"
                    "  resolve it in: %s\n"
                    "  then run git pathslice continue %s --from %s\n"
                    "  or replace continue with skip or abort\n"
                    % (short(source), subject, err.strip(), wt, st["name"], st["frm"]))
                return None
        st["queue"].pop(0)
        _save_state(repo, st)
    return _finalise(repo, st, quiet)


def _finalise(repo, st, quiet=False):
    wt = st.get("worktree")
    head = st.get("keep_sha") or (_wt_head(repo, wt) if wt else st["base_sha"])
    record = {
        "source": st["frm_sha"], "base": st["export_base"], "checked_base": st["base_sha"], "head": head,
        "replayed": _provenance(repo, st["scope"], head, "^" + st["export_base"]),
        "landed": st["landed"], "checkpoints": st["checkpoints"],
    }
    record_sha = st["record_before"]
    if record != st["record"]:
        record_sha = record_commit(repo, record, record_sha)
    at = repo.branch_checked_out_at(st["branch"])
    if at:
        raise SliceError("branch %s is checked out at %s; detach it first" % (st["branch"], at))
    zero = "0" * len(head)
    # A prior attempt may have committed the refs before removing its journal.
    if repo.rev(st["record_ref"]) == record_sha and repo.rev("refs/heads/" + st["branch"]) == head:
        st["record_before"], st["branch_before"] = record_sha, head
    repo.run("update-ref", "--stdin", input=
             "update refs/heads/%s %s %s\nupdate %s %s %s\n" % (
                 st["branch"], head, st["branch_before"] or zero,
                 st["record_ref"], record_sha, st["record_before"] or zero))
    if wt:
        _remove_worktree(repo, wt)
    _drop_state(repo, st["name"], st["frm"])
    if not quiet:
        if st.get("keep_sha"):
            print("%s: unchanged; use --force-rebuild to rebase onto %s" % (st["branch"], st["base"]))
        else:
            print("%s: %s + %d commits" % (st["branch"], st["base"], len(record["replayed"])))
        if st.get("conflicts_with_base"):
            sys.stderr.write("warning: %s no longer applies cleanly to %s; run --force-rebuild\n"
                             % (st["branch"], st["base"]))
    if st.get("push"):
        _push(repo, st["push"], st["branch"], st["frm_sha"], st["scope"], quiet)
    return head


def _push(repo, remote, branch, source, scope, quiet=False):
    ref = "refs/heads/" + branch
    local = repo.rev(ref)
    rc, url, _ = repo.try_run("remote", "get-url", "--push", remote)
    url = url.strip() if rc == 0 else remote
    key = hashlib.sha256(json.dumps([url, ref]).encode()).hexdigest()
    published_ref = REF_ROOT + "/published/" + key
    published = repo.rev(published_ref)
    expected = published or repo.rev("refs/remotes/%s/%s" % (remote, branch))
    out = repo.run("ls-remote", url, ref).split()
    actual = out[0] if out else None
    if actual != local:
        if actual and actual != expected:
            raise SliceError("remote branch changed since the last accepted export; "
                             "inspect and reconcile it before publishing")
        if actual and not published and not repo.is_ancestor(actual, local):
            mb = repo.run("merge-base", local, actual).strip()
            sources = _provenance(repo, scope, actual, "^" + mb)
            count = int(repo.run("rev-list", "--count", actual, "^" + mb))
            if len(sources) != count or not all(repo.is_ancestor(src, source) for src in sources):
                raise SliceError("the remote export does not match this scope and source history; "
                                 "reconcile it before publishing")
        repo.run("push", "--force-with-lease=%s:%s" % (ref, actual or ""), remote,
                 "%s:%s" % (local, ref))
    repo.run("update-ref", published_ref, local, published or "0" * len(local))
    if not quiet:
        print("%s is already up to date on %s" % (branch, remote) if actual == local
              else "pushed %s to %s" % (branch, remote))


def _branch_encodes(repo, an: Analysis, to_replay) -> bool:
    if not an.branch_sha or not to_replay:
        return False
    mb = repo.run("merge-base", an.base_sha, an.branch_sha).strip()
    return _provenance(repo, an.scope, an.branch_sha, "^" + mb) == [c.sha for c in to_replay]


def _conflicts_with_base(repo, an: Analysis) -> bool:
    if not repo.features()["merge_tree_write"]:
        return False
    rc, _, _ = repo.try_run("merge-tree", "--write-tree", an.base_sha, an.branch_sha)
    return rc == 1


def do_update(repo, an: Analysis, push=None, quiet=False, force_rebuild=False):
    if _load_state(repo, an.sl.name, an.frm):
        raise SliceError("an update of slice '%s' is in progress; run continue or abort" % an.sl.name)
    at = repo.branch_checked_out_at(an.branch)
    if at:
        raise SliceError("branch %s is checked out at %s; detach it first" % (an.branch, at))
    for warning in an.warnings:
        sys.stderr.write("warning: %s\n" % warning)
    to_replay = an.to_replay()
    st = {
        "name": an.sl.name, "frm": an.frm, "frm_sha": an.frm_sha,
        "base": an.base, "base_sha": an.base_sha, "export_base": an.base_sha,
        "branch": an.branch, "branch_before": an.branch_sha, "scope": an.scope,
        "paths": an.sl.paths, "worktree": None, "queue": [c.sha for c in to_replay],
        "record_ref": an.record_ref, "record_before": an.record_sha, "record": an.record,
        "landed": sorted(an.landed), "checkpoints": an.checkpoints, "push": push,
    }
    if not force_rebuild and _branch_encodes(repo, an, to_replay):
        st["keep_sha"] = an.branch_sha
        st["export_base"] = repo.run("merge-base", an.base_sha, an.branch_sha).strip()
        st["conflicts_with_base"] = _conflicts_with_base(repo, an)
        return _finalise(repo, st, quiet)
    if not to_replay:
        return _finalise(repo, st, quiet)
    wt = worktree_path(repo, an.sl.name, an.frm)
    st["worktree"] = wt
    _save_state(repo, st, create=True)
    _prepare_worktree(repo, wt, an.base_sha)
    return _run_queue(repo, st, quiet)


# ----------------------------------------------------------------- commands


def resolve_from(repo, frm: Optional[str]) -> str:
    if frm:
        return frm
    cur = repo.current_branch()
    if not cur:
        raise SliceError("HEAD is detached; say which branch to slice with --from")
    return cur


def cmd_add(repo, a):
    if not a.paths:
        raise SliceError("give at least one path")
    if a.select not in SELECTS:
        raise SliceError("--select must be one of " + ", ".join(SELECTS))
    existing = load_slices(repo).get(a.name)
    target = ["--file", SHARED_FILE] if a.shared else ["--local"]
    where = "shared" if a.shared else "local"
    if existing and where in existing.where:
        raise SliceError("slice '%s' is already defined (%s); remove it first with `git pathslice rm`" % (a.name, where))
    key = "pathslice.%s." % a.name
    for p in a.paths:
        repo.run("config", *target, "--add", key + "path", normalise_path(p))
    if a.base:
        repo.run("config", *target, key + "base", a.base)
    if a.select != "all":
        repo.run("config", *target, key + "select", a.select)
    if a.subject:
        repo.run("config", *target, key + "subject", a.subject)
    sl = get_slice(repo, a.name)
    print("slice %s: %s onto %s (%s)%s" % (a.name, " ".join(sl.paths), sl.base, where,
                                            "" if sl.select == "all" else ", select=" + sl.select))
    if a.shared and repo.run("status", "--porcelain", "--", SHARED_FILE).strip():
        print("note: %s is not committed yet; commit it so the definition travels with the repository"
              % SHARED_FILE)


def cmd_rm(repo, a):
    sl = load_slices(repo).get(a.name)
    if not sl:
        raise SliceError("no slice named '%s'" % a.name)
    where = "shared" if a.shared else "local"
    if where not in sl.where:
        raise SliceError("slice '%s' has no %s definition (defined: %s)" % (a.name, where, ", ".join(sl.where)))
    target = ["--file", SHARED_FILE] if a.shared else ["--local"]
    repo.run("config", *target, "--remove-section", "pathslice." + a.name)
    print("removed the %s definition of slice %s" % (where, a.name))


def cmd_list(repo, a):
    slices = load_slices(repo)
    if not slices:
        print("no slices defined (add one with `git pathslice add <name> <path>...`)")
        return
    for sl in slices.values():
        base = sl.base or default_base(repo) + " (default)"
        extra = "" if sl.select == "all" else "  select=" + sl.select
        if sl.subject:
            extra += "  subject=/%s/" % sl.subject
        print("%-12s %-14s %s  [%s]%s" % (sl.name, base, " ".join(sl.paths), ",".join(sl.where), extra))


def _print_analysis(repo, an: Analysis, verbose=True):
    print("slice %s: %s -> %s  (branch %s)" % (an.sl.name, an.frm, an.base, an.branch))
    if an.branch_sha:
        ahead = repo.run("rev-list", "--count", an.base_sha + ".." + an.branch_sha).strip()
        stale = "" if an.record.get("source") == an.frm_sha else ", built from an older %s" % an.frm
        merged = ", merged into %s" % an.base if an.landed_how == "merged" else ""
        print("  branch: %s ahead of %s%s%s" % (ahead, an.base, stale, merged))
    else:
        print("  branch: not built yet")
    if an.checkpoints:
        print("  manual checkpoints: %s" % ", ".join(map(short, an.checkpoints)))
    for w in an.warnings:
        print("  warning: %s" % w)
    n = len(an.to_replay())
    print("  pending: %d commit%s to replay" % (n, "" if n == 1 else "s"))
    if verbose:
        for c in an.candidates:
            tag = ""
            if not c.pure:
                tag += " [mixed]"
            if c.marked:
                tag += " [marked]"
            print("  %-18s %s %s%s" % (c.decision, short(c.sha), c.subject, tag))


def cmd_log(repo, a):
    sl = get_slice(repo, a.name)
    frm = resolve_from(repo, a.frm)
    an = analyse(repo, sl, frm, a.onto, a.all, a.branch)
    _print_analysis(repo, an, verbose=True)


def cmd_status(repo, a):
    slices = load_slices(repo)
    names = [a.name] if a.name else list(slices)
    if not names:
        print("no slices defined")
        return
    frm = resolve_from(repo, a.frm)
    for name in names:
        sl = get_slice(repo, name)
        try:
            an = analyse(repo, sl, frm, a.onto, a.all)
        except SliceError as e:
            print("slice %s: %s" % (name, e))
            continue
        _print_analysis(repo, an, verbose=False)


def cmd_update(repo, a):
    sl = get_slice(repo, a.name)
    frm = resolve_from(repo, a.frm)
    an = analyse(repo, sl, frm, a.onto, a.all, a.branch)
    ok = do_update(repo, an, a.push, a.quiet, a.force_rebuild)
    return 0 if ok else 1


def cmd_resume(repo, a) -> int:
    mode = a.cmd
    frm = resolve_from(repo, a.frm)
    st = _load_state(repo, a.name, frm)
    if not st:
        raise SliceError("no update of slice '%s' from %s is in progress" % (a.name, frm))
    wt = st["worktree"]
    if mode == "abort":
        if repo.worktree_registered(wt) and _am_in_progress(repo, wt):
            repo.run("am", "--abort", cwd=wt)
        _remove_worktree(repo, wt)
        _drop_state(repo, a.name, frm)
        print("aborted; %s left untouched" % st["branch"])
        return 0
    if "scope" not in st:
        raise SliceError("this update uses the old state format; abort it and run update again")
    if _am_in_progress(repo, wt):
        repo.run("am", "--" + mode, cwd=wt,
                 env_extra=_committer_env(repo, st["queue"][0]))
        if mode == "skip":
            st["queue"].pop(0)
            _save_state(repo, st)
    elif mode == "skip":
        raise SliceError("no patch is awaiting resolution; use continue")
    return 0 if _run_queue(repo, st, a.quiet) else 1


def cmd_forget(repo, a):
    frm = resolve_from(repo, a.frm)
    root = state_root(a.name, frm)
    for ref in repo.run("for-each-ref", "--format=%(refname)", root + "/exports/").splitlines():
        repo.delete_ref(ref)
    for suffix in ("/source", "/landed"):
        repo.delete_ref(root + suffix)
    if a.branch:
        br = branch_name(a.name, frm)
        if repo.rev("refs/heads/" + br):
            repo.run("branch", "-D", br)
    print("forgot the sync state of slice %s from %s" % (a.name, frm))


def cmd_landed(repo, a):
    frm = resolve_from(repo, a.frm)
    sha = repo.rev(a.rev)
    if not sha or not repo.is_ancestor(sha, frm):
        raise SliceError("%s must be an ancestor of %s" % (a.rev, frm))
    if _load_state(repo, a.name, frm):
        raise SliceError("an update is in progress; abort it before changing checkpoints")
    an = analyse(repo, get_slice(repo, a.name), frm)
    if any(repo.is_ancestor(sha, cp) for cp in an.checkpoints):
        print("%s is already covered by a manual checkpoint" % short(sha))
        return 0
    checkpoints = [cp for cp in an.checkpoints if not repo.is_ancestor(cp, sha)] + [sha]
    record = dict(an.record or {"source": an.frm_sha, "base": an.base_sha,
                               "head": None, "replayed": [], "landed": []}, checkpoints=checkpoints)
    head = record_commit(repo, record, an.record_sha)
    repo.run("update-ref", an.record_ref, head, an.record_sha or "0" * len(head))
    print("slice %s from %s: everything up to %s is now treated as landed" % (a.name, frm, short(sha)))


def github(repo, *args):
    p = subprocess.run(["gh", *args], cwd=repo.top, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, text=True)
    if p.returncode:
        raise SliceError("gh failed: " + p.stderr.strip())
    return p.stdout.strip()


def cmd_pr(repo, a):
    if not shutil.which("gh"):
        raise SliceError("`gh` (GitHub CLI) is not installed")
    repo.run("fetch", a.remote)
    frm = resolve_from(repo, a.frm)
    sl = get_slice(repo, a.name)
    an = analyse(repo, sl, frm, a.onto, a.all)
    head = an.branch_sha if a.no_update else do_update(repo, an, quiet=a.quiet,
                                                     force_rebuild=a.force_rebuild)
    if not head:
        if a.no_update:
            raise SliceError("branch %s does not exist" % an.branch)
        return 1
    rc, _, err = repo.try_run("diff", "--quiet", an.base_sha, head)
    if rc == 0:
        print("no changes to publish")
        return 0
    if rc != 1:
        raise SliceError(err.strip())
    _push(repo, a.remote, an.branch, an.frm_sha, an.scope, a.quiet)
    base = an.base.split("/", 1)[1] if an.base.startswith(a.remote + "/") else an.base
    url = github(repo, "pr", "list", "--head", an.branch, "--base", base, "--state", "open",
                 "--json", "url", "--jq", ".[0].url")
    if url:
        print("existing PR updated: %s" % url)
        return 0
    commits = repo.run("log", "--reverse", "--format=- %s (%h)", an.base_sha + ".." + head).strip()
    body = "Slice `%s` (%s) from `%s`.\n\n%s" % (sl.name, " ".join(sl.paths), frm, commits)
    cmd = ["pr", "create", "--base", base, "--head", an.branch,
           "--title", a.title or "%s: %s" % (sl.name, frm), "--body", body]
    if a.draft:
        cmd.append("--draft")
    print(github(repo, *cmd))
    return 0


# --------------------------------------------------------------------- main


def build_parser():
    p = argparse.ArgumentParser(prog="git pathslice", description=__doc__.split("\n\n")[0])
    p.add_argument("--version", action="version", version="git-pathslice " + VERSION)
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    def common(sp, frm=True, onto=True, all_=True, branch=False, quiet=False):
        if frm:
            sp.add_argument("--from", dest="frm", metavar="BRANCH",
                            help="source branch (default: the current branch)")
        if onto:
            sp.add_argument("--onto", metavar="BASE", help="override the slice's base for this run")
        if all_:
            sp.add_argument("--all", action="store_true",
                            help="ignore the slice's selection rule (pure/marked) for this run")
        if branch:
            sp.add_argument("--branch", metavar="NAME",
                            help="name of the derived branch (default: pathslice/<name>/<from>)")
        if quiet:
            sp.add_argument("-q", "--quiet", action="store_true")

    sp = sub.add_parser("add", help="define a slice")
    sp.add_argument("name")
    sp.add_argument("paths", nargs="*", metavar="path", help="paths or pathspecs that make up the slice")
    sp.add_argument("--base", metavar="BRANCH", help="branch the slice lands on (default: origin/HEAD, main or master)")
    sp.add_argument("--select", default="all", metavar="RULE",
                    help="all: every commit touching the paths (restricted to them); "
                         "pure: only commits that touch nothing else; "
                         "marked: only commits with a 'Slice: <name>' trailer or a matching --subject")
    sp.add_argument("--subject", metavar="REGEX", help="with --select marked: subjects matching this count as marked")
    sp.add_argument("--shared", action="store_true", help="write to %s (committed) instead of .git/config" % SHARED_FILE)
    sp.set_defaults(func=cmd_add)

    sp = sub.add_parser("rm", help="remove a slice definition")
    sp.add_argument("name")
    sp.add_argument("--shared", action="store_true",
                    help="remove the definition in %s instead of the local one" % SHARED_FILE)
    sp.set_defaults(func=cmd_rm)

    sp = sub.add_parser("list", help="list slices")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("log", help="show what an update would do, commit by commit")
    sp.add_argument("name")
    common(sp, branch=True)
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("status", help="summary of each slice for the current branch")
    sp.add_argument("name", nargs="?")
    common(sp)
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("update", help="rebuild the derived branch")
    sp.add_argument("name")
    common(sp, branch=True, quiet=True)
    sp.add_argument("--push", nargs="?", const="origin", metavar="REMOTE",
                    help="publish the derived branch with an explicit lease (default remote: origin)")
    sp.add_argument("--force-rebuild", action="store_true",
                    help="rebuild onto the current base even if the branch already holds the right "
                         "commits (changes commit ids, so an open PR is force-pushed)")
    sp.set_defaults(func=cmd_update)

    for name, hlp in (("continue", "resume an update after resolving a conflict"),
                     ("skip", "drop the conflicting commit and resume"),
                     ("abort", "abandon an update in progress")):
        sp = sub.add_parser(name, help=hlp)
        sp.add_argument("name")
        common(sp, onto=False, all_=False, quiet=True)
        sp.set_defaults(func=cmd_resume)

    sp = sub.add_parser("forget", help="drop the recorded sync state for a source branch")
    sp.add_argument("name")
    common(sp, onto=False, all_=False)
    sp.add_argument("--branch", action="store_true", help="also delete the derived branch")
    sp.set_defaults(func=cmd_forget)

    sp = sub.add_parser("landed", help="declare that everything up to a commit is already in base")
    sp.add_argument("name")
    sp.add_argument("rev")
    common(sp, onto=False, all_=False)
    sp.set_defaults(func=cmd_landed)

    sp = sub.add_parser("pr", help="update, push and open (or refresh) a pull request with gh")
    sp.add_argument("name")
    common(sp, quiet=True)
    sp.add_argument("--remote", default="origin")
    sp.add_argument("--title")
    sp.add_argument("--draft", action="store_true")
    sp.add_argument("--no-update", action="store_true", help="push the branch as it is")
    sp.add_argument("--force-rebuild", action="store_true", help="see `git pathslice update --force-rebuild`")
    sp.set_defaults(func=cmd_pr)
    return p


def main(argv=None):
    parser = build_parser()
    a = parser.parse_args(argv)
    if not a.cmd:
        parser.print_help()
        return 2
    try:
        repo = Repo()
        rc = a.func(repo, a)
        return rc or 0
    except SliceError as e:
        sys.stderr.write("fatal: %s\n" % e)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
