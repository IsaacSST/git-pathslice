#!/usr/bin/env python3
"""git pathslice: publish a branch's changes to selected paths as a separate pull request."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Iterator
from contextlib import contextmanager
from dataclasses import dataclass, field
from typing import Literal, overload

VERSION = "0.3.1"
SHARED_FILE = ".gitpathslices"
BRANCH_ROOT = "pathslice"
SLICE_TRAILER = "Pathslice-Slice"
SOURCE_TRAILER = "Pathslice-Source"
BASE_TRAILER = "Pathslice-Base"
UPSTREAM_TRAILER = "Pathslice-Upstream"
PATH_TRAILER = "Pathslice-Path"
TARGET_TRAILER = "Pathslice-Target"
LEGACY_TRAILER = "Sliced-From"
LEGACY_SCOPE_TRAILER = "Pathslice"
LEGACY_RECORDS = "refs/pathslices/branches/"
MIN_GIT = (2, 40)
# Settings that would change the output this script parses.
GIT_OPTIONS = ("-c", "log.showSignature=false", "-c", "i18n.logOutputEncoding=UTF-8")
# git merge-tree needs commits to find a merge base, and before Git 2.45 always; these temporary commits are
# never referenced.
SCRATCH_ENV = {"GIT_AUTHOR_NAME": "git-pathslice", "GIT_AUTHOR_EMAIL": "git-pathslice@invalid",
               "GIT_AUTHOR_DATE": "@1000000000 +0000", "GIT_COMMITTER_NAME": "git-pathslice",
               "GIT_COMMITTER_EMAIL": "git-pathslice@invalid", "GIT_COMMITTER_DATE": "@1000000000 +0000"}
UNNAMED_CONFLICT = "(a conflict git merge-tree reports without a file, such as a directory rename)"


class SliceError(Exception):
    pass


def _b(s: str | bytes | None) -> bytes | None:
    return s if isinstance(s, (bytes, type(None))) else s.encode("utf-8", "surrogateescape")


def _s(b: bytes) -> str:
    return b.decode("utf-8", "surrogateescape")


def short(sha: str) -> str:
    return sha[:10]


# Repository


class Repo:
    def __init__(self) -> None:
        rc, out, err = self._exec(["rev-parse", "--show-object-format", "--show-toplevel"], os.getcwd())
        if rc != 0:
            raise SliceError("not inside a git work tree")
        object_format, _, top = _s(out).rstrip("\n").partition("\n")
        self.top = top
        # An object name of zeros removes an entry in update-index --index-info.
        self.null = "0" * (64 if object_format == "sha256" else 40)
        self.cache: dict[tuple[str, ...], str] = {}
        self.queries: dict[tuple[str, ...], tuple[int, str, str]] = {}
        self.trees: dict[str, str] = {}
        self.listings: dict[tuple[str, ...], bytes] = {}
        self.git_version: tuple[int, int] | None = None

    @staticmethod
    def _exec(args: list[str], cwd: str, input: str | bytes | None = None,
              env: dict[str, str] | None = None) -> tuple[int, bytes, bytes]:
        p = subprocess.run(["git", *GIT_OPTIONS, *args], cwd=cwd, input=_b(input),
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
        return p.returncode, p.stdout, p.stderr

    @overload
    def try_run(self, *args: str, input: str | bytes | None = None,
                binary: Literal[False] = False, env_extra: dict[str, str] | None = None) -> tuple[int, str, str]: ...

    @overload
    def try_run(self, *args: str, input: str | bytes | None = None,
                binary: Literal[True], env_extra: dict[str, str] | None = None) -> tuple[int, bytes, str]: ...

    @overload
    def try_run(self, *args: str, input: str | bytes | None = None,
                binary: bool, env_extra: dict[str, str] | None = None) -> tuple[int, str | bytes, str]: ...

    def try_run(self, *args: str, input: str | bytes | None = None,
                binary: bool = False, env_extra: dict[str, str] | None = None) -> tuple[int, str | bytes, str]:
        env = {**os.environ, **env_extra} if env_extra else None
        rc, out, err = self._exec(list(args), self.top, input, env)
        return rc, (out if binary else _s(out)), _s(err)

    @overload
    def run(self, *args: str, input: str | bytes | None = None,
            binary: Literal[False] = False, env_extra: dict[str, str] | None = None) -> str: ...

    @overload
    def run(self, *args: str, input: str | bytes | None = None,
            binary: Literal[True], env_extra: dict[str, str] | None = None) -> bytes: ...

    def run(self, *args: str, input: str | bytes | None = None,
            binary: bool = False, env_extra: dict[str, str] | None = None) -> str | bytes:
        rc, out, err = self.try_run(*args, input=input, binary=binary, env_extra=env_extra)
        if rc != 0:
            raise SliceError("git %s failed:\n%s" % (" ".join(args[:2]), err.strip()))
        return out

    def query(self, *args: str) -> tuple[int, str, str]:
        """Run a read-only command, reusing the result of an identical earlier call."""
        if args not in self.queries:
            self.queries[args] = self.try_run(*args)
        return self.queries[args]

    def read(self, *args: str) -> str:
        rc, out, err = self.query(*args)
        if rc != 0:
            raise SliceError("git %s failed:\n%s" % (" ".join(args[:2]), err.strip()))
        return out

    def forget(self) -> None:
        """Discard remembered query results after changing references or configuration."""
        self.queries.clear()
        self.trees.clear()

    def rev(self, rev: str) -> str | None:
        rc, out, _ = self.query("rev-parse", "--verify", "--quiet", rev + "^{commit}")
        return out.strip() if rc == 0 else None

    def tree(self, rev: str) -> str:
        if rev not in self.trees:
            self.trees[rev] = self.read("rev-parse", rev + "^{tree}").strip()
        return self.trees[rev]

    def is_ancestor(self, a: str, b: str) -> bool:
        rc, _, err = self.query("merge-base", "--is-ancestor", a, b)
        if rc not in (0, 1):
            raise SliceError(err.strip())
        return rc == 0

    def merge_base(self, a: str, b: str) -> str | None:
        rc, out, _ = self.query("merge-base", a, b)
        return out.strip() if rc == 0 else None

    def current_branch(self) -> str | None:
        rc, out, _ = self.query("symbolic-ref", "--short", "-q", "HEAD")
        return out.strip() if rc == 0 else None

    def branch_checked_out_at(self, branch: str) -> str | None:
        path = None
        for line in self.run("worktree", "list", "--porcelain").splitlines():
            if line.startswith("worktree "):
                path = line[len("worktree "):]
            elif line == "branch refs/heads/" + branch:
                return path
        # Rebase and bisect can detach HEAD while retaining use of a branch.
        common = self.read("rev-parse", "--path-format=absolute", "--git-common-dir").rstrip("\n")
        gitdirs = [common]
        linked = os.path.join(common, "worktrees")
        if os.path.isdir(linked):
            gitdirs.extend(entry.path for entry in os.scandir(linked) if entry.is_dir())
        for gitdir in gitdirs:
            for state in ("rebase-merge/head-name", "rebase-apply/head-name",
                          "rebase-merge/update-refs", "BISECT_START"):
                filename = os.path.join(gitdir, state)
                if os.path.isfile(filename):
                    with open(filename) as f:
                        if any(line.strip() in (branch, "refs/heads/" + branch) for line in f):
                            return gitdir
        return None

    def check_ref_format(self, branch: str) -> None:
        rc, _, _ = self.query("check-ref-format", "--branch", branch)
        if rc != 0:
            raise SliceError("'%s' is not a valid branch name" % branch)

    def version(self) -> tuple[int, int]:
        if self.git_version is None:
            m = re.search(r"(\d+)\.(\d+)", self.run("--version"))
            self.git_version = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
        return self.git_version

    def check_version(self) -> None:
        if self.version() < MIN_GIT:
            raise SliceError("git pathslice needs git %d.%d or newer" % MIN_GIT)


# Configuration

@dataclass
class Slice:
    name: str
    paths: list[str] = field(default_factory=list)
    base: str | None = None
    upstream: str | None = None
    where: list[str] = field(default_factory=list)


def _config_entries(repo: Repo, regexp: str, *source: str) -> list[tuple[str, str]]:
    """Entries whose canonical names match regexp, as git config --get-regexp selects them."""
    rc, out, err = repo.query("config", "-z", *source, "--list")
    if rc != 0:
        raise SliceError(err.strip())
    entries = []
    for item in out.split("\0"):
        key, _, value = item.partition("\n")
        if item and re.search(regexp, key):
            entries.append((key, value))
    return entries


def load_slices(repo: Repo, rev: str | None = None) -> dict[str, Slice]:
    """Definitions in .gitpathslices at rev (otherwise the working tree), then local configuration."""
    shared: list[str] = []
    if rev and repo.query("cat-file", "-e", "%s:%s" % (rev, SHARED_FILE))[0] == 0:
        shared = ["--blob", "%s:%s" % (rev, SHARED_FILE)]
    elif os.path.exists(os.path.join(repo.top, SHARED_FILE)):
        shared = ["--file", SHARED_FILE]
    slices: dict[str, Slice] = {}
    for where, source in (("shared", shared), ("local", [])):
        if where == "shared" and not source:
            continue
        for key, value in _config_entries(repo, r"^pathslice\.", *source):
            name, _, field_ = key[len("pathslice."):].rpartition(".")
            if not name:
                continue
            sl = slices.setdefault(name, Slice(name=name))
            if where not in sl.where:
                sl.where.append(where)
            if field_ == "path":
                if value not in sl.paths:
                    sl.paths.append(value)
            elif field_ == "base":
                sl.base = value
            elif field_ == "upstream":
                sl.upstream = value
    return slices


def default_base(repo: Repo) -> str:
    rc, out, _ = repo.query("symbolic-ref", "-q", "refs/remotes/origin/HEAD")
    if rc == 0:
        return out.strip().replace("refs/remotes/", "", 1)
    for cand in ("main", "master"):
        if repo.rev(cand):
            return cand
    raise SliceError("cannot determine the base branch; specify --base")


def get_slice(repo: Repo, name: str, rev: str | None = None) -> Slice:
    slices = load_slices(repo, rev)
    if name not in slices:
        raise SliceError("no slice named '%s' (see `git pathslice list`)" % name)
    sl = slices[name]
    if not sl.paths:
        raise SliceError("slice '%s' has no paths" % name)
    if not sl.base:
        sl.base = default_base(repo)
    return sl


def normalise_path(repo: Repo, p: str) -> str:
    prefix = os.environ.get("GIT_PREFIX") or os.path.relpath(os.getcwd(), repo.top)
    if prefix not in ("", ".") and not p.startswith(":"):
        p = os.path.normpath(os.path.join(prefix, p))
    return p


def legacy_scope(name: str, paths: list[str], base: str) -> str:
    """The scope that git pathslice 0.2 recorded in its Pathslice trailers."""
    return hashlib.sha256(json.dumps([name, paths, base], ensure_ascii=True).encode()).hexdigest()


# Trees


@contextmanager
def _index() -> Iterator[dict[str, str]]:
    # A split index would leave shared index files in the repository.
    with tempfile.TemporaryDirectory(prefix="pathslice-") as tmp:
        yield {"GIT_INDEX_FILE": os.path.join(tmp, "index"), "GIT_CONFIG_COUNT": "1",
               "GIT_CONFIG_KEY_0": "core.splitIndex", "GIT_CONFIG_VALUE_0": "false"}


def _entries(repo: Repo, tree: str, paths: list[str]) -> bytes:
    """Entries for the paths in tree, as input for update-index --index-info."""
    key = (tree, *paths)
    if key in repo.listings:
        return repo.listings[key]
    rc, out = 1, b""
    # git ls-tree matches paths without pathspec magic or wildcards as git ls-files does.
    if not any(path.startswith(":") or any(c in path for c in "*?[\\") for path in paths):
        rc, out, _ = repo.try_run("ls-tree", "-r", "-z", "--full-tree", tree, "--", *paths, binary=True)
    if rc != 0:
        with _index() as env:
            repo.run("read-tree", tree, env_extra=env)
            out = repo.run("ls-files", "--stage", "-z", "--", *paths, binary=True, env_extra=env)
    repo.listings[key] = out
    return out


def _names(entries: bytes) -> list[bytes]:
    return [entry.partition(b"\t")[2] for entry in entries.split(b"\0") if entry]


def _rewrite(repo: Repo, tree: str | None, removed: list[bytes], added: bytes) -> str:
    """Return tree, or an empty tree if None, with the named entries removed and the given entries added."""
    null = repo.null.encode()
    info = b"".join(b"0 " + null + b"\t" + name + b"\0" for name in removed) + added
    with _index() as env:
        if tree:
            repo.run("read-tree", tree, env_extra=env)
        if info:
            repo.run("update-index", "-z", "--index-info", input=info, env_extra=env)
        return repo.run("write-tree", env_extra=env).strip()


def replace_paths(repo: Repo, rev: str, donor: str, paths: list[str]) -> str:
    """Return the tree of rev with the entries matching the pathspecs taken from donor."""
    return _rewrite(repo, rev, _names(_entries(repo, rev, paths)), _entries(repo, donor, paths))


def replace_names(repo: Repo, tree: str, donor: str, names: list[str]) -> str:
    """Return tree with the named files taken from donor, matching the names exactly."""
    wanted = sorted({os.fsencode(name) for name in names})
    listing = repo.run("ls-tree", "-r", "-z", "--full-tree", donor, binary=True).split(b"\0")
    added = b"".join(entry + b"\0" for entry in listing if entry.partition(b"\t")[2] in wanted)
    return _rewrite(repo, tree, wanted, added)


def slice_tree(repo: Repo, rev: str, paths: list[str]) -> str:
    key = ("slice", rev, *paths)
    if key not in repo.cache:
        repo.cache[key] = _rewrite(repo, None, [], _entries(repo, rev, paths))
    return repo.cache[key]


def scratch_commit(repo: Repo, tree: str, parents: list[str] | None = None) -> str:
    key = ("scratch", tree, *(parents or []))
    if key not in repo.cache:
        args = [arg for parent in parents or [] for arg in ("-p", parent)]
        repo.cache[key] = repo.run("commit-tree", tree, *args, input="git-pathslice\n",
                                   env_extra=SCRATCH_ENV).strip()
    return repo.cache[key]


def merge_trees(repo: Repo, ours: str, theirs: str, base: str) -> tuple[str, list[str]]:
    """Merge two trees, given their merge base; return the tree and the conflicted paths."""
    if repo.version() < (2, 45):
        # git merge-tree accepts trees from Git 2.45; earlier versions need commits.
        ours, theirs, base = (scratch_commit(repo, tree) for tree in (ours, theirs, base))
    return merge(repo, ours, theirs, base)


def merge(repo: Repo, ours: str, theirs: str, base: str | None = None) -> tuple[str, list[str]]:
    """Merge two commits without a worktree; return the tree and the conflicted paths."""
    args = ["merge-tree", "--write-tree", "-z", "--name-only", "--no-messages"]
    if base:
        args.append("--merge-base=" + base)
    rc, out, err = repo.try_run(*args, ours, theirs, binary=True)
    if rc not in (0, 1):
        raise SliceError("git merge-tree failed:\n" + err.strip())
    fields = out.split(b"\0")
    conflicts = []
    for name in fields[1:]:
        if not name:
            break
        conflicts.append(os.fsdecode(name))
    if rc == 1 and not conflicts:
        conflicts.append(UNNAMED_CONFLICT)
    return _s(fields[0]).strip(), conflicts


def diff_names(repo: Repo, a: str, b: str, paths: list[str] | None = None) -> list[str]:
    if a == b:
        return []
    out = repo.run("diff-tree", "-r", "-z", "--name-only", "--no-renames", a, b, "--", *(paths or []),
                   binary=True)
    return [os.fsdecode(name) for name in out.split(b"\0") if name]


# Measuring the source's changes


def first_parents(repo: Repo, tip: str, exclude: str) -> tuple[list[str], str | None]:
    """The first-parent chain from the commit tip, newest first, up to the first commit that exclude contains.

    Also returns that commit, or None if the chain ends first.
    """
    parent: dict[str, str | None] = {}
    for line in repo.read("rev-list", "--first-parent", "--parents", tip, "^" + exclude).splitlines():
        commit, *parents = line.split()
        parent[commit] = parents[0] if parents else None
    chain = []
    sha: str | None = tip
    while sha is not None and sha in parent:
        chain.append(sha)
        sha = parent[sha]
    return chain, sha


def last_merged(repo: Repo, ref: str, source: str) -> str | None:
    """The most recent commit on ref's first-parent chain that source contains."""
    tip = repo.rev(ref)
    if tip is None:
        raise SliceError("%s does not name a commit" % ref)
    return first_parents(repo, tip, source)[1]


def merged_commits(repo: Repo, sl: Slice, source: str, base: str) -> list[tuple[str, str]]:
    """The last commits source merged from the slice's upstream and base, upstream first."""
    merged = []
    upstream = [sl.upstream] if sl.upstream and sl.upstream != base else []
    for ref in upstream + [base]:
        sha = last_merged(repo, ref, source)
        if sha:
            merged.append((ref, sha))
    return merged


def measured_from(repo: Repo, paths: list[str], merged: list[str]) -> str:
    """Slice tree of the merge of the given commits, upstream first; conflicts take the upstream's version."""
    commits = list(dict.fromkeys(merged))
    if len(commits) > 1:
        # Leave out a commit that another one contains.
        independent = repo.read("merge-base", "--independent", *commits).split()
        commits = [c for c in commits if c in independent]
    if len(commits) == 1:
        return slice_tree(repo, commits[0], paths)
    tree, conflicts = merge(repo, commits[0], commits[1])
    measured = slice_tree(repo, tree, paths)
    if conflicts:
        measured = replace_names(repo, measured, slice_tree(repo, commits[0], paths), conflicts)
    return measured


def received_source(repo: Repo, sl: Slice, source: str, merged: list[tuple[str, str]]) -> str | None:
    """The newest commit of the source's own history that the upstream's last merged commit contains."""
    if len(merged) < 2:
        return None
    (upstream, upstream_merged), (_, base_merged) = merged[0], merged[-1]
    contained = set(repo.read("rev-list", upstream_merged, "^" + base_merged).split())
    upstream_tip = repo.rev(upstream)
    if not contained or upstream_tip is None:
        return None
    # The source's own history ends where it reaches the upstream's first-parent chain or the base.
    stop = set(first_parents(repo, upstream_tip, base_merged)[0])
    for sha in first_parents(repo, source, base_merged)[0]:
        if sha in stop:
            return None
        if sha in contained:
            return sha
    return None


def measured_tree(repo: Repo, sl: Slice, source: str, merged: list[tuple[str, str]], depth: int = 0) -> str:
    """Slice tree that the source's changes are measured against."""
    tree = measured_from(repo, sl.paths, [sha for _, sha in merged])
    received = received_source(repo, sl, source, merged)
    if received is None:
        return tree
    if depth == 3:
        raise SliceError("%s and %s have merged each other too often to separate the source's changes"
                         % (short(source), sl.upstream))
    # The upstream has merged part of the source: take that part out of the measure again.
    earlier = measured_tree(repo, sl, received, merged_commits(repo, sl, received, merged[-1][0]), depth + 1)
    tree, conflicts = merge_trees(repo, tree, earlier, slice_tree(repo, received, sl.paths))
    if conflicts:
        raise SliceError("%s merged %s at %s and has since changed the same parts of %s, so the source's changes "
                         "cannot be separated from it; merge the export's pull request before merging %s into "
                         "the source again" % (sl.upstream, short(source), short(received), ", ".join(conflicts),
                                               sl.upstream))
    return tree


def export_target(repo: Repo, sl: Slice, source: str, merged: list[tuple[str, str]], export_base: str,
                  landed_source: str | None = None) -> tuple[str, list[str], list[str]]:
    """export_base's tree with the source's changes to the slice applied.

    Also returns the conflicted paths, and the paths left at the base's version because the source's
    changes to them build on upstream changes that the base lacks.
    """
    measured = measured_tree(repo, sl, source, merged)
    landed = repo.rev(landed_source) if landed_source else None
    if landed and repo.is_ancestor(landed, source):
        # Changes that an earlier export has brought to the base count as merged.
        earlier = measured_tree(repo, sl, landed, merged_commits(repo, sl, landed, merged[-1][0]))
        adjusted, adjust_conflicts = merge_trees(repo, measured, slice_tree(repo, landed, sl.paths), earlier)
        if not adjust_conflicts:
            measured = adjusted
    base_slice = slice_tree(repo, export_base, sl.paths)
    changed, conflicts = merge_trees(repo, base_slice, slice_tree(repo, source, sl.paths), measured)
    deferred: list[str] = []
    if conflicts:
        # A conflict in a file the base has not changed since the source last merged it comes from the upstream.
        moved = set(diff_names(repo, slice_tree(repo, merged[-1][1], sl.paths), base_slice))
        deferred = [path for path in conflicts if path != UNNAMED_CONFLICT and path not in moved]
        conflicts = [path for path in conflicts if path not in deferred]
        if deferred:
            changed = replace_names(repo, changed, base_slice, deferred)
    if changed == base_slice:
        return repo.tree(export_base), conflicts, deferred
    return replace_paths(repo, export_base, changed, sl.paths), conflicts, deferred


# Export branches

TRAILERS = (SLICE_TRAILER, SOURCE_TRAILER, BASE_TRAILER, UPSTREAM_TRAILER, PATH_TRAILER, TARGET_TRAILER,
            LEGACY_TRAILER, LEGACY_SCOPE_TRAILER)
TRAILER_FORMAT = "%H%x1f%T%x1f%P" + "".join(
    "%%x1f%%(trailers:key=%s,valueonly,unfold,separator=%%x1d)" % key for key in TRAILERS)


@dataclass
class Meta:
    sha: str
    tree: str
    parents: list[str]
    trailers: dict[str, list[str]]

    def values(self, key: str) -> list[str]:
        return self.trailers.get(key, [])

    def first(self, key: str) -> str:
        values = self.values(key)
        return values[0] if values else ""

    @property
    def legacy(self) -> bool:
        return bool(self.values(LEGACY_TRAILER))

    @property
    def source(self) -> str | None:
        """The source commit this export commit was made from."""
        if self.legacy:
            return self.first(LEGACY_TRAILER) or None
        return self.first(SOURCE_TRAILER).rpartition(" ")[2] or None

    def made_for(self, name: str, scope: str) -> bool:
        return name in self.values(SLICE_TRAILER) or any(
            value.split()[:1] == [scope] for value in self.values(LEGACY_SCOPE_TRAILER))


def commit_meta(repo: Repo, *revs: str) -> list[Meta]:
    metas = []
    for line in repo.read("log", "--format=" + TRAILER_FORMAT, *revs).split("\n"):
        parts = line.split("\x1f")
        if len(parts) == 3 + len(TRAILERS):
            trailers = {key: [v.strip() for v in value.split("\x1d") if v.strip()]
                        for key, value in zip(TRAILERS, parts[3:])}
            metas.append(Meta(parts[0], parts[1], parts[2].split(), trailers))
            repo.trees[parts[0]] = parts[1]
    return metas


def commit_identity(repo: Repo, source: str, parents: list[str]) -> dict[str, str]:
    """Take identities from the source so that identical inputs produce identical commits."""
    revs = list(dict.fromkeys([source, *parents]))
    lines = repo.read("log", "--no-walk=unsorted", "--date=raw", "--format=%an%x1f%ae%x1f%ad%x1f%cn%x1f%ce%x1f%cd",
                      *revs).splitlines()
    idents = dict(zip(revs, (line.split("\x1f") for line in lines)))
    an, ae, ad, cn, ce, _ = idents[source]
    dates = [idents[rev][5] for rev in revs]
    return {"GIT_AUTHOR_NAME": an, "GIT_AUTHOR_EMAIL": ae, "GIT_AUTHOR_DATE": "@" + ad,
            "GIT_COMMITTER_NAME": cn, "GIT_COMMITTER_EMAIL": ce,
            "GIT_COMMITTER_DATE": "@" + max(dates, key=lambda date: int(date.split()[0]))}


def derived(repo: Repo, meta: Meta, name: str, scope: str) -> bool:
    """Whether a commit is exactly as git pathslice made it, so that it can be made again."""
    if not meta.made_for(name, scope) or not meta.source or not repo.rev(meta.source):
        return False
    committer = "--format=%cn%x1f%ce%x1f%cd"
    actual = repo.read("log", "-1", "--date=raw", committer, meta.sha).strip()
    if meta.legacy:
        # Version 0.2 gave each replayed commit its source commit's committer.
        return actual == repo.read("log", "-1", "--date=raw", committer, meta.source).strip()
    env = commit_identity(repo, meta.source, meta.parents)
    return actual == "\x1f".join((env["GIT_COMMITTER_NAME"], env["GIT_COMMITTER_EMAIL"],
                                  env["GIT_COMMITTER_DATE"][1:]))


def branch_mappings(repo: Repo) -> dict[str, dict[str, str]]:
    """Export branches recorded in branch.<name>.pathsliceSlice, pathsliceSource and pathsliceBase."""
    found: dict[str, dict[str, str]] = {}
    for key, value in _config_entries(repo, r"^branch\..*\.pathslice(slice|source|base)$"):
        branch, _, var = key[len("branch."):].rpartition(".")
        found.setdefault(branch, {})[var] = value
    return found


def record_branch(repo: Repo, plan: Plan) -> None:
    values = {"pathsliceSlice": plan.sl.name, "pathsliceSource": plan.frm, "pathsliceBase": plan.base}
    if plan.export.recorded != {var.lower(): value for var, value in values.items()}:
        for var, value in values.items():
            repo.run("config", "--local", "branch.%s.%s" % (plan.branch, var), value)
        repo.forget()


def legacy_records(repo: Repo) -> list[dict[str, str]]:
    """Branch records written by git pathslice 0.2."""
    records = []
    for text in repo.read("for-each-ref", "--format=%(contents)%00", LEGACY_RECORDS).split("\0"):
        try:
            record = json.loads(text)
        except ValueError:
            continue
        if isinstance(record, dict) and all(isinstance(record.get(k), str) for k in ("slice", "source_ref", "branch")):
            records.append({k: record[k] for k in ("slice", "source_ref", "branch")})
    return records


def branch_name(name: str, frm: str) -> str:
    return "%s/%s/%s" % (BRANCH_ROOT, name, frm)


def resolve_branch(repo: Repo, name: str, frm: str, base: str, branch: str | None = None) -> str:
    if branch:
        return branch
    mapped = {b: m for b, m in branch_mappings(repo).items()
              if m.get("pathsliceslice") == name and m.get("pathslicesource") == frm}
    # A slice and source can have one export branch for each base; older records lack the base.
    candidates = (sorted(b for b, m in mapped.items() if m.get("pathslicebase") == base)
                  or sorted(b for b, m in mapped.items() if not m.get("pathslicebase")))
    if not mapped:
        candidates = sorted({r["branch"] for r in legacy_records(repo) if (r["slice"], r["source_ref"]) == (name, frm)})
    if len(candidates) > 1:
        raise SliceError("several branches export slice %s from %s onto %s (%s); choose one with --branch"
                         % (name, frm, base, ", ".join(candidates)))
    return candidates[0] if candidates else branch_name(name, frm)


def _branch_part(repo: Repo, ref: str) -> str:
    """The branch name in refs/heads/<name> or refs/remotes/<remote>/<name>."""
    if ref.startswith("refs/heads/"):
        return ref[len("refs/heads/"):]
    for remote in sorted(repo.read("remote").splitlines(), key=len, reverse=True):
        prefix = "refs/remotes/" + remote + "/"
        if ref.startswith(prefix):
            return ref[len(prefix):]
    return ref


def _local_branch_ref(repo: Repo, revision: str) -> str:
    rc, out, _ = repo.query("rev-parse", "--symbolic-full-name", "--verify", "--quiet", revision)
    ref = out.strip() if rc == 0 else ""
    return "refs/heads/" + _branch_part(repo, ref) if ref.startswith("refs/remotes/") else ref


def check_branch_name(repo: Repo, branch: str, frm: str, base: str) -> None:
    repo.check_ref_format(branch)
    ref = "refs/heads/" + branch
    if repo.query("symbolic-ref", "-q", ref)[0] == 0:
        raise SliceError("export branch %s is a symbolic reference; use a direct branch" % branch)
    if any(ref == _local_branch_ref(repo, rev) for rev in (frm, base)):
        raise SliceError("export branch %s is the source or base branch; choose another --branch" % branch)


@dataclass
class Export:
    branch: str
    local: str | None
    remote: str | None
    remote_tip: str | None
    recorded: dict[str, str] = field(default_factory=dict)
    tip: str | None = None
    previous: Meta | None = None
    last: Meta | None = None
    notes: list[str] = field(default_factory=list)


def _choose_tip(repo: Repo, ex: Export, name: str, scope: str, base_tip: str, fetched: bool) -> str | None:
    """The commit the update builds on: the local branch or its remote-tracking branch."""
    local, remote_tip = ex.local, ex.remote_tip
    if not remote_tip or local == remote_tip:
        return local
    fork = repo.merge_base(local, remote_tip) if local else None
    if not local or fork == local:
        return remote_tip
    if fork == remote_tip:
        return local
    remote_branch = "%s/%s" % (ex.remote, ex.branch)
    if not fetched:
        ex.notes.append("%s and %s have diverged; publish reconciles them" % (ex.branch, remote_branch))
        return local
    own = commit_meta(repo, local, "^" + remote_tip, "^" + base_tip)
    if all(derived(repo, meta, name, scope) for meta in own):
        ex.notes.append("replacing %d local commit(s) made by git pathslice with %s" % (len(own), remote_branch))
        return remote_tip
    raise SliceError("%s has commits that are neither on %s nor made by git pathslice; push or remove them first"
                     % (ex.branch, remote_branch))


def read_export(repo: Repo, sl: Slice, frm: str, branch: str, base: str, base_tip: str,
                remote: str | None, fetched: bool) -> Export:
    local = repo.rev("refs/heads/" + branch)
    remote_tip = repo.rev("refs/remotes/%s/%s" % (remote, branch)) if remote else None
    ex = Export(branch, local, remote, remote_tip, branch_mappings(repo).get(branch, {}))
    scope = legacy_scope(sl.name, sl.paths, base)
    ex.tip = _choose_tip(repo, ex, sl.name, scope, base_tip, fetched)
    if ex.tip is None:
        return ex
    for meta in commit_meta(repo, "--first-parent", ex.tip, "^" + base_tip):
        if meta.made_for(sl.name, scope) and (not meta.legacy or len(meta.parents) < 2):
            ex.previous = meta
            break
    # A branch already merged into the base ends with the export commit it last received.
    ex.last = ex.previous or next((meta for meta in commit_meta(repo, "-1", ex.tip)
                                   if meta.made_for(sl.name, scope)), None)
    known = ((ex.recorded.get("pathsliceslice"), ex.recorded.get("pathslicesource")) == (sl.name, frm)
             or any((r["slice"], r["source_ref"], r["branch"]) == (sl.name, frm, branch) for r in legacy_records(repo)))
    if not (known or ex.last):
        raise SliceError("branch %s is not an export of slice %s; choose another --branch" % (branch, sl.name))
    return ex


def export_landed(repo: Repo, tip: str, base_tip: str) -> bool:
    """Whether the base holds the export branch's changes, through its commits or through others."""
    fork = repo.merge_base(tip, base_tip)
    if fork == tip:
        return True
    if fork == base_tip:
        return False
    changed = diff_names(repo, fork, tip) if fork else []
    if not changed:
        return False
    merged_tree, conflicts = merge(repo, base_tip, tip)
    if not conflicts and merged_tree == repo.tree(base_tip):
        return True
    # A squash merge, possibly followed by further changes to the same files: a commit on the base
    # with the export branch's version of every file it changed.
    assert fork is not None
    literal = [":(literal)" + path for path in changed]
    trees = repo.read("rev-list", "--no-commit-header", "--format=%T", "-n", "50", "--first-parent", base_tip,
                      "^" + fork, "--", *literal).split()
    if not trees:
        return False
    tip_tree = repo.tree(tip)
    pairs = [("%s %s\n" % (tree, tip_tree)).encode() for tree in trees]
    out = repo.run("diff-tree", "--stdin", "-r", "-z", "--name-only", "--", *literal, input=b"".join(pairs),
                   binary=True)
    # git diff-tree prints each pair of trees, followed by the names of the files that differ between them.
    differences = []
    rest = out
    for pair in pairs:
        before, found, rest = rest.partition(pair)
        if not found:
            raise SliceError("unexpected output from git diff-tree --stdin")
        differences.append(before)
    differences.append(rest)
    return not all(differences[1:])


# Plans


@dataclass
class Plan:
    sl: Slice
    frm: str
    source: str
    base: str
    base_tip: str
    merged: list[tuple[str, str]]
    export: Export
    fresh: bool
    landed: bool
    export_base: str
    parents: list[str]
    target: str
    result: str
    conflicts: list[str]
    deferred: list[str]
    export_conflicts: list[str]
    export_only: list[str]
    base_conflicts: list[str]

    @property
    def branch(self) -> str:
        return self.export.branch


def previous_target(repo: Repo, sl: Slice, ex: Export, base: str, base_tip: str) -> str:
    """The tree the export branch was last given, without changes made on the branch since."""
    assert ex.tip is not None
    prev = ex.previous
    if prev is None:
        return repo.tree(repo.merge_base(ex.tip, base_tip) or ex.tip)
    if prev.legacy:
        return repo.tree(prev.sha)
    # Without the source commit, a source branch that is behind it cannot be told from one that was rewritten.
    source = repo.rev(prev.source) if prev.source else None
    if source is None:
        raise SliceError("%s was last exported from %s, which this repository does not have; fetch it, or run "
                         "with --rebuild to start the branch again" % (ex.branch, short(prev.source or "?")))
    recorded = prev.first(TARGET_TRAILER)
    if re.fullmatch(r"[0-9a-f]{40}([0-9a-f]{24})?", recorded) and (
            recorded == prev.tree or repo.query("cat-file", "-e", recorded + "^{tree}")[0] == 0):
        return recorded
    # Recompute the export with the definition it was made with, which the commit records.
    old_base = prev.first(BASE_TRAILER) or base
    old = Slice(sl.name, prev.values(PATH_TRAILER) or sl.paths, old_base, prev.first(UPSTREAM_TRAILER) or None)
    export_base = repo.merge_base(prev.sha, base_tip)
    merged = merged_commits(repo, old, source, old_base)
    if export_base and merged:
        tree, conflicts, _ = export_target(repo, old, source, merged, export_base)
        if not conflicts:
            return tree
    raise SliceError("cannot recompute what %s last exported; run with --rebuild to start it again" % ex.branch)


def make_plan(repo: Repo, sl: Slice, frm: str, base: str | None = None, branch: str | None = None,
              remote: str | None = None, fetched: bool = False, rebuild: bool = False) -> Plan:
    source = _source(repo, frm)
    base = base or sl.base or default_base(repo)
    base_tip = repo.rev(base)
    if base_tip is None:
        raise SliceError("base %s does not name a commit" % base)
    merged = merged_commits(repo, sl, source, base)
    if not merged or merged[-1][0] != base:
        raise SliceError("%s shares no history with %s" % (frm, base))
    name = resolve_branch(repo, sl.name, frm, base, branch)
    check_branch_name(repo, name, frm, base)
    ex = read_export(repo, sl, frm, name, base, base_tip, remote, fetched)
    if ex.last and not rebuild:
        recorded = ex.last.first(BASE_TRAILER)
        if recorded and recorded != base:
            raise SliceError("branch %s exports slice %s onto %s; choose another --branch for %s, or run with "
                             "--rebuild" % (name, sl.name, recorded, base))
        previous = ex.previous.source if ex.previous else None
        if previous and previous != source and repo.rev(previous) and repo.is_ancestor(source, previous):
            raise SliceError("%s was last exported from %s, which is newer than %s; update %s and run this "
                             "command again" % (name, short(previous), frm, frm))
    landed = ex.tip is not None and not rebuild and export_landed(repo, ex.tip, base_tip)
    fresh = rebuild or ex.tip is None or landed
    export_base, parents = base_tip, [base_tip]
    if not fresh:
        assert ex.tip is not None
        export_base, parents = repo.merge_base(ex.tip, base_tip) or base_tip, [ex.tip]
        if not repo.is_ancestor(merged[-1][1], export_base):
            # The source has merged a newer base than the export branch holds.
            export_base, parents = base_tip, [ex.tip, base_tip]
    landed_source = ex.last.source if landed and ex.last else None
    target, conflicts, deferred = export_target(repo, sl, source, merged, export_base, landed_source)
    result = target
    export_conflicts: list[str] = []
    export_only: list[str] = []
    base_conflicts: list[str] = []
    if not fresh and not conflicts:
        assert ex.tip is not None
        previous_tree = previous_target(repo, sl, ex, base, base_tip)
        if previous_tree != repo.tree(ex.tip):
            # Keep changes made on the export branch since it was exported, such as review suggestions.
            result, export_conflicts = merge_trees(repo, repo.tree(ex.tip), target, previous_tree)
        if not export_conflicts:
            export_only = diff_names(repo, target, result)
            # A commit that merges the base cannot conflict with it. When nothing changes, the branch tip
            # stands in for the commit to be made.
            if base_tip not in parents:
                unchanged = result == repo.tree(ex.tip) and parents == [ex.tip]
                commit = ex.tip if unchanged else scratch_commit(repo, result, parents)
                _, base_conflicts = merge(repo, base_tip, commit)
    return Plan(sl=sl, frm=frm, source=source, base=base, base_tip=base_tip, merged=merged, export=ex,
                fresh=fresh, landed=landed, export_base=export_base, parents=parents, target=target, result=result,
                conflicts=conflicts, deferred=deferred, export_conflicts=export_conflicts,
                export_only=export_only, base_conflicts=base_conflicts)


def source_commits(repo: Repo, plan: Plan, since: str | None = None) -> list[tuple[str, str]]:
    excludes = ["^" + sha for _, sha in plan.merged]
    if since and repo.rev(since):
        excludes.append("^" + since)
    out = repo.read("log", "--reverse", "--format=%H%x1f%s", plan.source, *excludes, "--", *plan.sl.paths)
    return [(sha, subject) for sha, _, subject in (line.partition("\x1f") for line in out.split("\n") if line)]


def exported_since(plan: Plan, landed_only: bool = False) -> str | None:
    """The source of the export commit that the listed source commits follow."""
    last = plan.export.last
    if last is None or not (plan.landed or (not plan.fresh and not landed_only)):
        return None
    return last.source


def commit_message(repo: Repo, plan: Plan) -> str:
    listed = ["- %s (%s)" % (subject, short(sha)) for sha, subject in source_commits(repo, plan, exported_since(plan))]
    lines = ["%s: %s from %s" % (plan.sl.name, "export" if plan.fresh else "update", plan.frm), ""]
    lines += listed or ["No new commit on %s changes these paths directly." % plan.frm]
    if len(plan.parents) > 1:
        lines += ["", "Follows %s at %s." % (plan.base, short(plan.base_tip))]
    lines += ["", "%s: %s" % (SLICE_TRAILER, plan.sl.name), "%s: %s %s" % (SOURCE_TRAILER, plan.frm, plan.source),
              "%s: %s" % (BASE_TRAILER, plan.base)]
    if plan.sl.upstream:
        lines.append("%s: %s" % (UPSTREAM_TRAILER, plan.sl.upstream))
    lines += ["%s: %s" % (PATH_TRAILER, path) for path in plan.sl.paths]
    # The export before changes made on the branch were kept, so that the next update need not compute it again.
    lines.append("%s: %s" % (TARGET_TRAILER, plan.target))
    return "\n".join(lines) + "\n"


def _files(n: int) -> str:
    return "%d file%s" % (n, "" if n == 1 else "s")


def changed_paths(repo: Repo, plan: Plan) -> list[str]:
    """Slice paths the planned commit changes on the export branch, or on the base for a new export."""
    reference = plan.base_tip if plan.fresh else plan.export.tip
    assert reference is not None
    return diff_names(repo, repo.tree(reference), plan.result, plan.sl.paths)


def plan_notes(plan: Plan) -> list[str]:
    notes = []
    if plan.export_only:
        notes.append("%s has changes that %s lacks in:\n  %s\nmake them in %s as well so that both pull requests "
                     "agree" % (plan.branch, plan.frm, "\n  ".join(plan.export_only), plan.frm))
    if plan.deferred:
        notes.append("not exported, because the changes build on %s changes that %s lacks:\n  %s"
                     % (plan.sl.upstream, plan.base, "\n  ".join(plan.deferred)))
    if plan.base_conflicts:
        notes.append("%s conflicts with %s in:\n  %s\nmerge %s into %s, then update"
                     % (plan.branch, plan.base, "\n  ".join(plan.base_conflicts), plan.base, plan.frm))
    return notes


def move_branch(repo: Repo, plan: Plan, new: str) -> None:
    local = plan.export.local
    if new == local:
        return
    at = repo.branch_checked_out_at(plan.branch)
    if at:
        raise SliceError("branch %s is checked out or in use at %s; finish the Git operation or switch branches"
                         % (plan.branch, at))
    repo.run("update-ref", "-m", "git pathslice", "refs/heads/" + plan.branch, new, local or repo.null)
    repo.forget()


def apply(repo: Repo, plan: Plan, quiet: bool = False, rebuild: bool = False) -> str | None:
    """Write the planned commit to the export branch; return the branch tip, or None if nothing is exported."""
    ex = plan.export
    if plan.conflicts:
        raise SliceError("the changes %s makes to slice %s conflict with %s in:\n  %s\n"
                         "merge %s into %s, resolve the conflicts there, then run this command again"
                         % (plan.frm, plan.sl.name, plan.base, "\n  ".join(plan.conflicts), plan.base, plan.frm))
    if plan.export_conflicts:
        raise SliceError("%s has changes that %s lacks and that conflict with its new changes in:\n  %s\n"
                         "make those changes in %s, or run again with --rebuild to discard them"
                         % (plan.branch, plan.frm, "\n  ".join(plan.export_conflicts), plan.frm))
    for note in ex.notes:
        sys.stderr.write("note: %s\n" % note)
    changed = changed_paths(repo, plan)
    if plan.fresh and not changed:
        for note in plan_notes(plan):
            print("note: " + note)
        if rebuild and ex.tip and ex.tip != plan.base_tip:
            move_branch(repo, plan, plan.base_tip)
            record_branch(repo, plan)
            if not quiet:
                print("%s: started again at %s with nothing to export" % (plan.branch, plan.base))
            return plan.base_tip
        if not quiet:
            print("nothing to export: %s has no changes to %s that %s lacks"
                  % (plan.frm, " ".join(plan.sl.paths), plan.base))
        return None
    new = ex.tip if not changed else repo.run(
        "commit-tree", plan.result, *[arg for p in plan.parents for arg in ("-p", p)],
        input=commit_message(repo, plan), env_extra=commit_identity(repo, plan.source, plan.parents)).strip()
    assert new is not None
    move_branch(repo, plan, new)
    record_branch(repo, plan)
    if not quiet:
        if not changed:
            fetched = " with %s/%s" % (ex.remote, plan.branch) if new != ex.local else ""
            print("%s is up to date%s" % (plan.branch, fetched))
        elif plan.fresh:
            print("%s: %s on %s" % (plan.branch, _files(len(changed)), plan.base))
        else:
            follows = " and follows %s" % plan.base if len(plan.parents) > 1 else ""
            print("%s: %s updated%s" % (plan.branch, _files(len(changed)), follows))
    for note in plan_notes(plan):
        print("note: " + note)
    return new


def upstream_hint(repo: Repo, plan: Plan) -> str | None:
    sl = plan.sl
    if sl.upstream:
        return None
    chain = repo.read("rev-list", "--first-parent", "--parents", plan.source, "^" + plan.merged[-1][1]).splitlines()
    if not chain:
        return None
    advice = ("if it is developed against another branch, set that branch as the upstream: "
              "git config pathslice.%s.upstream BRANCH" % sl.name)
    own = _branch_part(repo, _local_branch_ref(repo, plan.frm))
    refs = repo.read("for-each-ref", "--format=%(refname)", "--contains", chain[-1].split()[0],
                    "--no-contains", plan.source, "refs/heads", "refs/remotes").splitlines()
    others = [ref.split("/", 2)[2] for ref in refs if not ref.endswith("/HEAD") and _branch_part(repo, ref) != own]
    # Integration branches such as dev usually have the shortest names.
    others.sort(key=lambda name: (len(name.rsplit("/", 1)[-1]), name))
    if others:
        return "%s shares commits with %s; %s" % (plan.frm, ", ".join(others[:3]) + (", ..." if len(others) > 3
                                                                                      else ""), advice)
    if any(not repo.is_ancestor(parent, plan.base_tip) for line in chain for parent in line.split()[2:]):
        return "%s merges commits that are not on %s; %s" % (plan.frm, plan.base, advice)
    return None


def print_plan(repo: Repo, plan: Plan, verbose: bool = False) -> None:
    ex = plan.export
    print("slice %s: %s -> %s  (branch %s)" % (plan.sl.name, plan.frm, plan.base, plan.branch))
    print("  measured from: %s" % ", ".join("%s at %s" % (ref, short(sha)) for ref, sha in plan.merged))
    if plan.conflicts:
        print("  conflicts with %s in: %s" % (plan.base, ", ".join(plan.conflicts)))
    elif plan.export_conflicts:
        print("  changes on the branch conflict with new changes in: %s" % ", ".join(plan.export_conflicts))
    else:
        changed = changed_paths(repo, plan)
        if not changed:
            state = "up to date" if not plan.fresh else "nothing to export"
        elif not plan.fresh:
            state = "%s to update" % _files(len(changed))
            if len(plan.parents) > 1:
                state += " and a merge of %s" % plan.base
        elif plan.landed:
            state = "merged into %s; %s to export in a new commit" % (plan.base, _files(len(changed)))
        else:
            state = "not created; %s to export" % _files(len(changed))
        print("  branch: " + state)
        for note in plan_notes(plan):
            print("  note: " + note.replace("\n", "\n  "))
    hint = upstream_hint(repo, plan)
    for note in ex.notes + ([hint] if hint else []):
        print("  note: " + note)
    if verbose:
        commits = source_commits(repo, plan, exported_since(plan, landed_only=True))
        print("  source commits:" if commits else "  source commits: none")
        for sha, subject in commits:
            print("    %s %s" % (short(sha), subject))
        if not plan.conflicts and not plan.export_conflicts:
            files = diff_names(repo, repo.tree(plan.export_base), plan.result, plan.sl.paths)
            print("  files in the export:" if files else "  files in the export: none")
            for path in files:
                print("    %s" % path)


# Publication


def remote_value(repo: Repo, remote: str, branch: str) -> str | None:
    ref = "refs/heads/" + branch
    for line in repo.read("ls-remote", remote, ref).splitlines():
        sha, _, name = line.partition("\t")
        if name == ref:
            return sha
    return None


def push(repo: Repo, plan: Plan, new: str, remote: str, force: bool = False, quiet: bool = False) -> list[str]:
    """Push the export branch; return the messages the server sent, such as a link for opening a pull request."""
    ref = "refs/heads/" + plan.branch
    actual = remote_value(repo, remote, plan.branch)
    if new == actual:
        if not quiet:
            print("%s is already up to date on %s" % (plan.branch, remote))
        return []
    if actual:
        if repo.rev(actual) is None:
            raise SliceError("%s on %s has commits that this repository lacks; run git pathslice publish to "
                             "include them" % (plan.branch, remote))
        # A forced push replaces only commits that were fetched and built on, or that the base already holds.
        tip = plan.export.tip
        seen = actual == plan.export.remote_tip or (tip is not None and repo.is_ancestor(actual, tip))
        if not (repo.is_ancestor(actual, new) or (force and seen) or export_landed(repo, actual, plan.base_tip)):
            raise SliceError("%s on %s has commits that %s lacks; run git pathslice publish to include them"
                             % (plan.branch, remote, plan.branch))
    rc, _, err = repo.try_run("push", "--force-with-lease=%s:%s" % (ref, actual or ""), remote, "%s:%s" % (new, ref))
    if rc != 0:
        raise SliceError("git push failed:\n" + err.strip())
    repo.forget()
    if not quiet:
        print("pushed %s to %s" % (plan.branch, remote))
    return [line for line in err.splitlines() if line.startswith("remote:") and line[len("remote:"):].strip()]


def github(repo: Repo, *args: str) -> str:
    try:
        p = subprocess.run(["gh", *args], cwd=repo.top, stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, text=True)
    except OSError as e:
        raise SliceError("gh failed: %s" % e)
    if p.returncode:
        raise SliceError("gh failed: " + p.stderr.strip())
    return p.stdout.strip()


def pull_request(repo: Repo, a: argparse.Namespace, plan: Plan, base: str) -> str:
    """Reuse the open pull request from the export branch into the base, or create one, with gh."""
    url = github(repo, "pr", "list", "--head", plan.branch, "--base", base, "--state", "open",
                 "--json", "url", "--jq", ".[0].url")
    if url:
        return "using existing PR: %s" % url
    commits = "\n".join("- %s (%s)" % (subject, short(sha))
                        for sha, subject in source_commits(repo, plan, exported_since(plan, landed_only=True)))
    body = "Slice `%s` (%s) from `%s`.\n\n%s" % (plan.sl.name, " ".join(plan.sl.paths), plan.frm, commits)
    cmd = ["pr", "create", "--base", base, "--head", plan.branch,
           "--title", a.title or "%s: %s" % (plan.sl.name, plan.frm), "--body", body]
    if a.draft:
        cmd.append("--draft")
    return "created PR: %s" % github(repo, *cmd)


# Commands


def resolve_from(repo: Repo, frm: str | None) -> str:
    if frm:
        return frm
    cur = repo.current_branch()
    if not cur:
        raise SliceError("HEAD is detached; specify the source branch with --from")
    recorded = branch_mappings(repo).get(cur, {}).get("pathslicesource")
    legacy = [r["source_ref"] for r in legacy_records(repo) if r["branch"] == cur] if not recorded else []
    return recorded or (legacy[0] if legacy else cur)


def _source(repo: Repo, frm: str) -> str:
    sha = repo.rev(frm)
    if sha is None:
        raise SliceError("%s does not name a commit" % frm)
    return sha


def _default_remote(repo: Repo) -> str | None:
    return "origin" if "origin" in repo.read("remote").split() else None


def cmd_add(repo: Repo, a: argparse.Namespace) -> None:
    if not a.paths:
        raise SliceError("specify at least one path")
    existing = load_slices(repo).get(a.name)
    target = ["--file", SHARED_FILE] if a.shared else ["--local"]
    where = "shared" if a.shared else "local"
    if existing and where in existing.where:
        raise SliceError("slice '%s' is already defined (%s); remove it first with `git pathslice rm`" % (a.name, where))
    key = "pathslice.%s." % a.name
    for p in a.paths:
        repo.run("config", *target, "--add", key + "path", normalise_path(repo, p))
    for option in ("base", "upstream"):
        if getattr(a, option):
            repo.run("config", *target, key + option, getattr(a, option))
    repo.forget()
    sl = get_slice(repo, a.name)
    print("slice %s: %s onto %s%s (%s)" % (a.name, " ".join(sl.paths), sl.base,
                                          ", upstream " + sl.upstream if sl.upstream else "", where))
    if a.shared and repo.run("status", "--porcelain", "--untracked-files=all", "--", SHARED_FILE).strip():
        print("note: %s is not committed yet; commit it so the definition travels with the repository"
              % SHARED_FILE)


def cmd_rm(repo: Repo, a: argparse.Namespace) -> None:
    sl = load_slices(repo).get(a.name)
    if not sl:
        raise SliceError("no slice named '%s'" % a.name)
    where = "shared" if a.shared else "local"
    if where not in sl.where:
        raise SliceError("slice '%s' has no %s definition (defined: %s)" % (a.name, where, ", ".join(sl.where)))
    target = ["--file", SHARED_FILE] if a.shared else ["--local"]
    repo.run("config", *target, "--remove-section", "pathslice." + a.name)
    repo.forget()
    print("removed the %s definition of slice %s" % (where, a.name))


def cmd_list(repo: Repo, a: argparse.Namespace) -> None:
    slices = load_slices(repo)
    if not slices:
        print("no slices defined (add one with `git pathslice add <name> <path>...`)")
        return
    for sl in slices.values():
        base = sl.base or default_base(repo) + " (default)"
        upstream = "  upstream=" + sl.upstream if sl.upstream else ""
        print("%-12s %-14s %s  [%s]%s" % (sl.name, base, " ".join(sl.paths), ",".join(sl.where), upstream))


def cmd_log(repo: Repo, a: argparse.Namespace) -> None:
    frm = resolve_from(repo, a.frm)
    plan = make_plan(repo, get_slice(repo, a.name, _source(repo, frm)), frm, a.onto, a.branch,
                     _default_remote(repo))
    print_plan(repo, plan, verbose=True)


def cmd_status(repo: Repo, a: argparse.Namespace) -> None:
    if a.branch and not a.name:
        raise SliceError("--branch needs a slice name")
    frm = resolve_from(repo, a.frm)
    source = _source(repo, frm)
    names = [get_slice(repo, a.name, source).name] if a.name else list(load_slices(repo, source))
    if not names:
        print("no slices defined")
        return
    for name in names:
        try:
            plan = make_plan(repo, get_slice(repo, name, source), frm, a.onto, a.branch, _default_remote(repo))
        except SliceError as e:
            print("slice %s: %s" % (name, e))
            continue
        print_plan(repo, plan)


def cmd_update(repo: Repo, a: argparse.Namespace) -> int:
    frm = resolve_from(repo, a.frm)
    plan = make_plan(repo, get_slice(repo, a.name, _source(repo, frm)), frm, a.onto, a.branch,
                     a.push or _default_remote(repo), rebuild=a.rebuild)
    new = apply(repo, plan, a.quiet, a.rebuild)
    if a.push and new:
        push(repo, plan, new, a.push, force=a.rebuild, quiet=a.quiet)
    return 0


def cmd_publish(repo: Repo, a: argparse.Namespace) -> int:
    if not a.quiet:
        print("fetching %s" % a.remote)
    repo.run("fetch", a.remote)
    repo.forget()
    frm = resolve_from(repo, a.frm)
    sl = get_slice(repo, a.name, _source(repo, frm))
    plan = make_plan(repo, sl, frm, a.onto, a.branch, a.remote, fetched=True, rebuild=a.rebuild)
    base = plan.base.split("/", 1)[1] if plan.base.startswith(a.remote + "/") else plan.base
    if not a.quiet:
        print("slice %s: %s" % (sl.name, " ".join(sl.paths)))
        print("  source branch: %s (committed changes)" % frm)
        print("  export branch: %s" % plan.branch)
        print("  PR base: %s" % base)
    if a.no_update:
        for note in plan.export.notes:
            sys.stderr.write("note: %s\n" % note)
        new = plan.export.local or plan.export.tip
        if new is None:
            raise SliceError("branch %s does not exist" % plan.branch)
        move_branch(repo, plan, new)
    else:
        new = apply(repo, plan, a.quiet, a.rebuild)
    if new is None:
        return 0
    if repo.tree(repo.merge_base(plan.base_tip, new) or plan.base_tip) == repo.tree(new):
        if remote_value(repo, a.remote, plan.branch) in (None, new):
            print("no changes to publish")
        else:
            push(repo, plan, new, a.remote, force=a.rebuild, quiet=a.quiet)
            print("no changes remain in %s; a pull request from it now shows none" % plan.branch)
        return 0
    messages = push(repo, plan, new, a.remote, force=a.rebuild, quiet=a.quiet)
    # The export branch is published; the pull request needs gh and a repository on GitHub.
    if shutil.which("gh"):
        try:
            print(pull_request(repo, a, plan, base))
            return 0
        except SliceError as e:
            reason = str(e)
    else:
        reason = "gh, the GitHub CLI, is not installed"
    if not a.quiet:
        for line in messages:
            print(line)
    sys.stderr.write("note: no pull request was opened from %s into %s: %s\n" % (plan.branch, base, reason))
    return 0


# Command-line interface


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="git pathslice", description=__doc__)
    p.add_argument("--version", action="version", version="git-pathslice " + VERSION)
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    def common(sp: argparse.ArgumentParser, quiet: bool = False) -> None:
        sp.add_argument("--from", dest="frm", metavar="BRANCH",
                        help="source of committed changes (default: the current branch or its recorded source)")
        sp.add_argument("--onto", metavar="BASE", help="base branch (default: the slice's configured base)")
        sp.add_argument("--branch", metavar="NAME",
                        help="export branch (default: the recorded branch or pathslice/<name>/<from>)")
        if quiet:
            sp.add_argument("-q", "--quiet", action="store_true", help="suppress progress summaries")

    sp = sub.add_parser("add", help="define a slice")
    sp.add_argument("name")
    sp.add_argument("paths", nargs="*", metavar="path", help="paths or pathspecs to export")
    sp.add_argument("--base", metavar="BRANCH", help="branch the export targets (default: origin/HEAD, main or master)")
    sp.add_argument("--upstream", metavar="BRANCH",
                    help="branch the source is developed against, if not the base; its changes are not exported")
    sp.add_argument("--shared", action="store_true", help="write the definition to %s" % SHARED_FILE)
    sp.set_defaults(func=cmd_add)

    sp = sub.add_parser("rm", help="remove a slice definition")
    sp.add_argument("name")
    sp.add_argument("--shared", action="store_true",
                    help="remove the definition in %s instead of the local one" % SHARED_FILE)
    sp.set_defaults(func=cmd_rm)

    sp = sub.add_parser("list", help="list slices")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("log", help="show the source commits and the files the export contains")
    sp.add_argument("name")
    common(sp)
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("status", help="summarise each slice for the current branch")
    sp.add_argument("name", nargs="?")
    common(sp)
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("update", help="add the source's latest changes to the export branch")
    sp.add_argument("name")
    common(sp, quiet=True)
    sp.add_argument("--push", nargs="?", const="origin", metavar="REMOTE",
                    help="push the export branch with an explicit lease (default remote: origin)")
    sp.add_argument("--rebuild", action="store_true",
                    help="start the export branch again from the base, discarding its commits")
    sp.set_defaults(func=cmd_update)

    sp = sub.add_parser(
        "publish", aliases=["pr"], help="publish the source's changes to the slice as a pull request",
        description="Fetch the remote, add the source's latest changes to the slice's export branch, push it, "
                    "then create or reuse an open PR against the base with the GitHub CLI (gh), if it is "
                    "installed. The source branch remains unchanged. Merge the PR separately.",
        epilog="Example: git pathslice publish docs --from feature. "
               "Use 'git pathslice log docs' to preview the export. 'pr' is an alias for 'publish'.",
    )
    sp.add_argument("name", metavar="SLICE", help="configured slice defining the paths and base")
    common(sp, quiet=True)
    sp.add_argument("--remote", default="origin", help="remote to fetch and push (default: %(default)s)")
    sp.add_argument("--title", help="title when creating a PR")
    sp.add_argument("--draft", action="store_true", help="create a new PR as a draft")
    sp.add_argument("--no-update", action="store_true",
                    help="publish the export branch as it is; still fetch, push and create or reuse a PR")
    sp.add_argument("--rebuild", action="store_true",
                    help="start the export branch again from the base, discarding its commits")
    sp.set_defaults(func=cmd_publish)
    return p


def main(argv: list[str] | None = None) -> int:
    for stream in (sys.stdout, sys.stderr):
        # File names that are not valid UTF-8 are printed as their original bytes.
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure:
            reconfigure(errors="surrogateescape")
    parser = build_parser()
    a = parser.parse_args(argv)
    if not a.cmd:
        parser.print_help()
        return 2
    try:
        repo = Repo()
        repo.check_version()
        rc: int | None = a.func(repo, a)
        return rc or 0
    except SliceError as e:
        sys.stderr.write("fatal: %s\n" % e)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
